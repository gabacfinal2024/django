{
  "info": {
    "name": "Library API",
    "description": "Django Library CRD API – List, Create, Delete for Authors, Books, Members, Loans",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" }
  ],
  "item": [
    {
      "name": "Authors",
      "item": [
        {
          "name": "List Authors",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/authors/"
          }
        },
        {
          "name": "Create Author",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\"\n}"
            },
            "url": "{{baseUrl}}/api/authors/create/"
          }
        },
        {
          "name": "Delete Author",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/authors/1/delete/"
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "List Books",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/books/"
          }
        },
        {
          "name": "Create Book",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Python for Beginners\",\n  \"isbn\": \"978-0123456789\",\n  \"author_id\": 1,\n  \"published\": \"2024-01-15\"\n}"
            },
            "url": "{{baseUrl}}/api/books/create/"
          }
        },
        {
          "name": "Delete Book",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/books/1/delete/"
          }
        }
      ]
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "List Members",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/members/"
          }
        },
        {
          "name": "Create Member",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Smith\",\n  \"email\": \"john@example.com\",\n  \"phone\": \"555-1234\",\n  \"join_date\": \"2024-01-01\"\n}"
            },
            "url": "{{baseUrl}}/api/members/create/"
          }
        },
        {
          "name": "Delete Member",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/members/1/delete/"
          }
        }
      ]
    },
    {
      "name": "Loans",
      "item": [
        {
          "name": "List Loans",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/loans/"
          }
        },
        {
          "name": "Create Loan",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"book_id\": 1,\n  \"member_id\": 1,\n  \"loan_date\": \"2024-02-01\",\n  \"due_date\": \"2024-02-15\"\n}"
            },
            "url": "{{baseUrl}}/api/loans/create/"
          }
        },
        {
          "name": "Delete Loan",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/loans/1/delete/"
          }
        }
      ]
    }
  ]
}
